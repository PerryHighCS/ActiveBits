{
  "name": "activebits-server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "sh -c 'if [ -f dist/server.js ]; then node dist/server.js; else node --import tsx server.ts; fi'",
    "dev": "node --trace-warnings --import tsx server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "sh -c 'set -e; files=$(find . -not -path \"./node_modules/*\" -name \"*.test.ts\" -print); if [ -z \"$files\" ]; then echo \"No server tests found\"; exit 0; fi; node --import tsx --test $files'",
    "test:nonport": "npm run test",
    "typecheck": "tsc --noEmit",
    "test:valkey": "node --import tsx test-valkey.ts",
    "monitor:valkey": "node --import tsx monitor-valkey.ts"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "brython": "~3.14.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.1",
    "ioredis": "^5.11.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
